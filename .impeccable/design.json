  "narrative": {
    "northStar": "Charcoal and brass",
    "overview": "The existing identity pairs dark, quiet surfaces with muted brass and ivory. Cinematic artwork provides atmosphere; a solid launch console gives text and controls a stable, readable surface. The user approved the cinematic launch-bar composition in `.impeccable/mocks/concept-a.png` on 2026-10-16. Its surface-specific direction lives in `.impeccable/surfaces/launcher-order1886-launcher-py.md`.\n\nThis is a Windows Tkinter application. The native title bar, focus behavior, dialogs, buttons and dropdown semantics are intentional adaptations of the composition. The current implementation in `launcher/order1886_launcher.py` is the token source. This document records the implemented system; it does not certify completion of the visual review or runtime compatibility.",
    "keyCharacteristics": [
      "Cinematic artwork with an opaque, anchored launch console.",
      "Georgia display lettering and readable Segoe UI controls.",
      "Brass reserved for identity, the main action, focus and the compatibility notice.",
      "Real controls and text remain separate from generated imagery."
    ],
    "rules": [
      {
        "name": "The One Primary Action Rule",
        "body": "Play owns the strongest visual emphasis; its active session state becomes Stop. Settings, verification and logs remain secondary.",
        "section": "layout"
      },
      {
        "name": "The Semantic Overlay Rule",
        "body": "Wordmark, labels, controls and state indicators are drawn by the application, never embedded as mockup UI in the background.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve the charcoal, brass and ivory identity and the Georgia / Segoe UI pairing.",
      "**Do** keep Play, the game folder and essential settings immediately available.",
      "**Do** keep semantic native controls, visible focus and keyboard access.",
      "**Do** verify the minimum window and long warning states after layout changes.",
      "**Do** keep readiness and experimental-runtime compatibility messages visibly distinct."
    ],
    "donts": [
      "**Don't** bake interface text, controls or status claims into generated artwork.",
      "**Don't** replace the native stack solely to reproduce mockup chrome.",
      "**Don't** present a frame-rate choice or file-readiness indicator as gameplay or performance evidence.",
      "**Don't** treat this documentation as closure of the open Impeccable review gates.",
      ""
    ]
  }
