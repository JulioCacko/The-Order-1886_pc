#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "order1886-runtime.manifest"
1 ICON "../../launcher/order1886/native/order1886.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "The Order: 1886 PC Runtime\0"
            VALUE "InternalName", "order1886-runtime\0"
            VALUE "OriginalFilename", "order1886-runtime.exe\0"
            VALUE "ProductName", "The Order: 1886 PC\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
